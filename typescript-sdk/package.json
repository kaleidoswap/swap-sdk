{
  "name": "@kaleidoswap/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for KaleidoSwap (RGB Lightning Node + swaps) over WebAssembly",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "src"],
  "scripts": {
    "generate:types": "openapi-typescript ../specs/rgb-lightning-node.yaml --export-type --enum --dedupe-enums -o src/generated/node-types.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "devDependencies": {
    "openapi-typescript": "^7",
    "typescript": "^5"
  }
}
