@@ -0,0 +1,240 @@
+//! Shared SDK contract fixtures: no database or live wallet required.
+use std::str::FromStr;
+
+use bitcoin::{
+    hashes::{sha256, Hash},
+    OutPoint, Psbt, ScriptBuf,
+};
+use maker_layer_rgb::{
+    build_taker_claim_psbt, claim_leaf_witness_weight, maker_lock_fee_sat, maker_spend_fee_sat,
+    rgb_lib, taker_claim_htlc_sat, TakerClaimParams,
+};
+use maker_musig::{
+    lockup_address, reverse_swap_tree, submarine_swap_tree, Chain, CooperativeKey, LeafVersion,
+    SwapTree,
+};
+use serde_json::Value;
+
+const WIRE: &str = include_str!("../../../tests/fixtures/rgb-v1/wire-contract.json");
+const GOLDEN: &str = include_str!("../../../tests/fixtures/rgb-v1/rgb-golden-vectors.json");
+fn text(value: &Value) -> &str {
+    value.as_str().expect("fixture string")
+}
+
+#[test]
+fn maker_reconstructs_the_shared_swap_trees_and_addresses() {
+    let f: Value = serde_json::from_str(WIRE).unwrap();
+    let preimage = hex::decode(text(&f["preimage"])).unwrap();
+    let hash = sha256::Hash::hash(&preimage).to_byte_array();
+    for name in ["submarine", "reverse"] {
+        let request = &f["create"][name]["request"];
+        let response = &f["create"][name]["response"];
+        let (claim, refund, address_field) = if name == "submarine" {
+            (
+                &response["claimPublicKey"],
+                &request["refundPublicKey"],
+                "address",
+            )
+        } else {
+            (
+                &request["claimPublicKey"],
+                &response["refundPublicKey"],
+                "lockupAddress",
+            )
+        };
+        let claim = hex::decode(text(claim)).unwrap();
+        let refund = hex::decode(text(refund)).unwrap();
+        let height = u32::try_from(response["timeoutBlockHeight"].as_u64().unwrap()).unwrap();
+        let tree = if name == "submarine" {
+            submarine_swap_tree(LeafVersion::Bitcoin, &hash, &claim, &refund, height)
+        } else {
+            reverse_swap_tree(LeafVersion::Bitcoin, &hash, &claim, &refund, height)
+        }
+        .unwrap();
+        assert_eq!(
+            tree,
+            SwapTree::from_boltz_json(&response["swapTree"]).unwrap()
+        );
+        let cooperative = if name == "submarine" {
+            CooperativeKey::from_bytes(&claim, &refund)
+        } else {
+            CooperativeKey::from_bytes_reverse(&claim, &refund)
+        }
+        .unwrap();
+        assert_eq!(
+            lockup_address(&cooperative, &tree, Chain::Regtest).unwrap(),
+            text(&response[address_field])
+        );
+        let script = bitcoin::Address::from_str(text(&response[address_field]))
+            .unwrap()
+            .require_network(bitcoin::Network::Regtest)
+            .unwrap()
+            .script_pubkey();
+        assert_eq!(
+            script.to_hex_string(),
+            text(&response["rgb"]["scriptPubkey"])
+        );
+        assert_eq!(
+            rgb_lib::utils::recipient_id_from_script_buf(script, rgb_lib::BitcoinNetwork::Regtest)
+                .unwrap(),
+            text(&response["rgb"]["recipientId"])
+        );
+        assert_eq!(response["rgb"]["assetId"], f["contractId"]);
+        assert_eq!(
+            response["rgb"]["amount"],
+            response[if name == "submarine" {
+                "expectedAmount"
+            } else {
+                "onchainAmount"
+            }]
+        );
+    }
+}
+
+#[test]
+fn rgb_lib_reencodes_every_frozen_recipient() {
+    let g: Value = serde_json::from_str(GOLDEN).unwrap();
+    for v in g["recipients"].as_array().unwrap() {
+        let net = match text(&v["network"]) {
+            "bc" => rgb_lib::BitcoinNetwork::Mainnet,
+            "tb3" => rgb_lib::BitcoinNetwork::Testnet,
+            "tb4" => rgb_lib::BitcoinNetwork::Testnet4,
+            "sb" => rgb_lib::BitcoinNetwork::Signet,
+            "sbc" => rgb_lib::BitcoinNetwork::SignetCustom,
+            "bcrt" => rgb_lib::BitcoinNetwork::Regtest,
+            other => panic!("unknown network {other}"),
+        };
+        let script = ScriptBuf::from_bytes(hex::decode(text(&v["scriptPubkey"])).unwrap());
+        let id = rgb_lib::utils::recipient_id_from_script_buf(script.clone(), net).unwrap();
+        assert_eq!(id, text(&v["recipientId"]));
+        assert_eq!(
+            rgb_lib::utils::script_buf_from_recipient_id(id)
+                .unwrap()
+                .unwrap(),
+            script
+        );
+    }
+}
+
+#[test]
+fn maker_claim_psbt_and_pricing_match_the_frozen_reference() {
+    let f: Value = serde_json::from_str(WIRE).unwrap();
+    let g: Value = serde_json::from_str(GOLDEN).unwrap();
+    let reference = &g["takerClaim"];
+    let recorded = Psbt::from_str(text(&reference["psbt"])).unwrap();
+    let weight = claim_leaf_witness_weight(
+        hex::decode(text(
+            &f["create"]["reverse"]["response"]["swapTree"]["claimLeaf"]["output"],
+        ))
+        .unwrap()
+        .len() as u64,
+    );
+    let actual = build_taker_claim_psbt(&TakerClaimParams {
+        htlc_outpoint: OutPoint::from_str(text(&reference["outpoint"])).unwrap(),
+        htlc_txout: recorded.inputs[0].witness_utxo.clone().unwrap(),
+        htlc_witness_weight: weight,
+        fee_rate_sat_vb: 5,
+        dest_script: ScriptBuf::from_bytes(
+            hex::decode(text(&reference["destinationScript"])).unwrap(),
+        ),
+    })
+    .unwrap();
+    assert_eq!(actual, recorded);
+    let fees = &g["feeModel"];
+    assert_eq!(fees["claimFeeRate"], 5);
+    assert_eq!(
+        fees["claimPayoutSat"],
+        actual.unsigned_tx.output[1].value.to_sat()
+    );
+    assert_eq!(
+        fees["reverseHtlcSat"],
+        taker_claim_htlc_sat(weight, 5).unwrap()
+    );
+    assert_eq!(
+        fees["claimVsize"],
+        (taker_claim_htlc_sat(weight, 1).unwrap() - 546)
+    );
+    assert_eq!(fees["makerLockVsize"], maker_lock_fee_sat(1).unwrap());
+    assert_eq!(fees["reverseLockFeeSat"], maker_lock_fee_sat(5).unwrap());
+    assert_eq!(taker_claim_htlc_sat(weight, 5).unwrap(), 1_521);
+    assert_eq!(maker_lock_fee_sat(5).unwrap(), 1_560);
+    let sub_weight = claim_leaf_witness_weight(
+        hex::decode(text(
+            &f["create"]["submarine"]["response"]["swapTree"]["claimLeaf"]["output"],
+        ))
+        .unwrap()
+        .len() as u64,
+    );
+    assert_eq!(maker_spend_fee_sat(sub_weight, 5).unwrap() - 1_000, 470);
+    assert_eq!(
+        fees["makerClaimVsize"],
+        maker_spend_fee_sat(sub_weight, 1).unwrap()
+    );
+    assert_eq!(
+        fees["submarineMinerFeeSat"],
+        maker_spend_fee_sat(sub_weight, 5).unwrap() - 1_000
+    );
+    assert_eq!(
+        f["create"]["submarine"]["response"]["expectedAmount"],
+        (100_000u64 + 470).div_ceil(100)
+    );
+    assert_eq!(
+        f["create"]["reverse"]["response"]["onchainAmount"],
+        (100_000u64 - 1_521 - 1_560) / 100
+    );
+}
+
+#[test]
+fn public_response_schemas_preserve_the_frozen_json_shape() {
+    use maker_api::schemas::{ReverseCreateResponse, RgbLock, SubmarineCreateResponse};
+    let f: Value = serde_json::from_str(WIRE).unwrap();
+    let rgb = |response: &Value| {
+        let r = &response["rgb"];
+        RgbLock {
+            asset_id: text(&r["assetId"]).into(),
+            amount: r["amount"].as_u64().unwrap(),
+            recipient_id: text(&r["recipientId"]).into(),
+            blinding: text(&r["blinding"]).into(),
+            htlc_sat: r["htlcSat"].as_u64().unwrap(),
+            claim_fee_rate: r["claimFeeRate"].as_u64(),
+            script_pubkey: text(&r["scriptPubkey"]).into(),
+            transport_endpoints: serde_json::from_value(r["transportEndpoints"].clone()).unwrap(),
+            min_confirmations: u8::try_from(r["minConfirmations"].as_u64().unwrap()).unwrap(),
+        }
+    };
+    let s = &f["create"]["submarine"]["response"];
+    let submarine = SubmarineCreateResponse {
+        id: text(&s["id"]).into(),
+        swap_auth: text(&s["swapAuth"]).into(),
+        claim_public_key: text(&s["claimPublicKey"]).into(),
+        address: text(&s["address"]).into(),
+        swap_tree: serde_json::from_value(s["swapTree"].clone()).unwrap(),
+        timeout_block_height: u32::try_from(s["timeoutBlockHeight"].as_u64().unwrap()).unwrap(),
+        expected_amount: s["expectedAmount"].as_u64().unwrap(),
+        accept_zero_conf: false,
+        bip21: String::new(),
+        referral_id: None,
+        asset_id: None,
+        fee_asset_id: None,
+        preimage_hash: None,
+        invoice_amount: None,
+        rgb: Some(rgb(s)),
+    };
+    assert_eq!(serde_json::to_value(submarine).unwrap(), *s);
+    let r = &f["create"]["reverse"]["response"];
+    let reverse = ReverseCreateResponse {
+        id: text(&r["id"]).into(),
+        swap_auth: text(&r["swapAuth"]).into(),
+        invoice: text(&r["invoice"]).into(),
+        refund_public_key: text(&r["refundPublicKey"]).into(),
+        lockup_address: text(&r["lockupAddress"]).into(),
+        swap_tree: serde_json::from_value(r["swapTree"].clone()).unwrap(),
+        timeout_block_height: r["timeoutBlockHeight"].as_i64().unwrap(),
+        onchain_amount: r["onchainAmount"].as_u64().unwrap(),
+        blinding_key: None,
+        asset_id: None,
+        fee_asset_id: None,
+        rgb: Some(rgb(r)),
+    };
+    assert_eq!(serde_json::to_value(reverse).unwrap(), *r);
+}
