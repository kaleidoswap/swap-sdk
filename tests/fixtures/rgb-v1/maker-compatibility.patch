@@ -0,0 +1,141 @@
+//! Explicit fixture capture through the real router; no live wallet or asset proofs.
+mod common;
+
+use bitcoin::{
+    hashes::{sha256, Hash},
+    ScriptBuf,
+};
+use common::rgb::{
+    call, htlc_keyring, htlc_pair, htlc_post, htlc_publish_default, htlc_state, htlc_venue,
+    HTLC_INVOICE_SAT,
+};
+use maker_core::SwapType;
+use maker_layer_rgb::{
+    rgb_lib, MockRgbHtlc, MockRgbProvider, RgbBalance, RgbBtcBalance, RgbError, RgbNetwork,
+};
+use maker_node::mock_bolt11_invoice;
+use serde_json::json;
+use std::sync::Arc;
+
+const ASSET: &str = "rgb:WM~4iI3a-IIHtpsc-UoTNdky-~aYnGmB-~KF3h4r-BBd0zqQ";
+fn recipient(script: &ScriptBuf) -> maker_layer_rgb::Result<String> {
+    rgb_lib::utils::recipient_id_from_script_buf(script.clone(), rgb_lib::BitcoinNetwork::Regtest)
+        .map_err(|e| RgbError::Htlc(e.to_string()))
+}
+
+#[tokio::test]
+#[ignore = "explicit capture requires TEST_DATABASE_URL and RGB_WIRE_FIXTURE_OUTPUT"]
+async fn capture_rgb_wire_contract() {
+    let output = std::env::var("RGB_WIRE_FIXTURE_OUTPUT").expect("explicit output directory");
+    assert!(
+        std::env::var("TEST_DATABASE_URL").is_ok(),
+        "require explicit isolated DB"
+    );
+    let preimage = [3u8; 32];
+    let hash = sha256::Hash::hash(&preimage).to_byte_array();
+    let mut create = json!({});
+    let mut pairs = json!({});
+    let mut recipients = vec![];
+    let mut claim = json!(null);
+    for (name, kind) in [
+        ("submarine", SwapType::Submarine),
+        ("reverse", SwapType::Reverse),
+    ] {
+        let (_db, state) = htlc_state(kind, hash)
+            .await
+            .expect("database must be reachable");
+        let wallet = Arc::new(MockRgbProvider::new(RgbNetwork::Regtest));
+        wallet.set_ready(true);
+        let balance = RgbBalance {
+            settled: 10_000_000,
+            future: 10_000_000,
+            spendable: 10_000_000,
+        };
+        wallet.set_asset_balance(ASSET, balance);
+        wallet.set_asset_precision(ASSET, 6);
+        wallet.set_btc_balance(RgbBtcBalance {
+            vanilla: balance,
+            colored: RgbBalance::default(),
+        });
+        let ops = Arc::new(MockRgbHtlc::new().with_recipient_encoder(recipient));
+        let state = state
+            .with_rgb_provider(wallet, Some(ASSET.into()))
+            .with_rgb_htlc(htlc_venue(ops, 12));
+        htlc_publish_default(&state, kind).await;
+        let public_key = hex::encode(htlc_keyring(kind).derive(99).unwrap().public_key());
+        let request = if name == "submarine" {
+            json!({"from":"USDT-RGB", "to":"BTC", "pairId":htlc_pair(kind), "refundPublicKey":public_key, "invoice":mock_bolt11_invoice(hash, HTLC_INVOICE_SAT)})
+        } else {
+            json!({"from":"BTC", "to":"USDT-RGB", "pairId":htlc_pair(kind), "claimPublicKey":public_key, "preimageHash":hex::encode(hash), "invoiceAmount":HTLC_INVOICE_SAT})
+        };
+        let (status, response) = htlc_post(state.clone(), kind, &request).await;
+        assert_eq!(status, axum::http::StatusCode::CREATED, "{response}");
+        let (status, cards) = call(state, &format!("/v2/swap/{name}"), None).await;
+        assert_eq!(status, axum::http::StatusCode::OK, "{cards}");
+        pairs[name] = cards;
+        let script_hex = response["rgb"]["scriptPubkey"].as_str().unwrap();
+        let script = ScriptBuf::from_bytes(hex::decode(script_hex).unwrap());
+        for (prefix, network) in [
+            ("bc", rgb_lib::BitcoinNetwork::Mainnet),
+            ("tb3", rgb_lib::BitcoinNetwork::Testnet),
+            ("tb4", rgb_lib::BitcoinNetwork::Testnet4),
+            ("sb", rgb_lib::BitcoinNetwork::Signet),
+            ("sbc", rgb_lib::BitcoinNetwork::SignetCustom),
+            ("bcrt", rgb_lib::BitcoinNetwork::Regtest),
+        ] {
+            let id = rgb_lib::utils::recipient_id_from_script_buf(script.clone(), network).unwrap();
+            assert_eq!(
+                rgb_lib::utils::script_buf_from_recipient_id(id.clone())
+                    .unwrap()
+                    .unwrap(),
+                script
+            );
+            recipients.push(json!({"scriptPubkey":script_hex, "network":prefix, "recipientId":id}));
+        }
+        if name == "reverse" {
+            let outpoint = bitcoin::OutPoint::new(bitcoin::Txid::from_byte_array([0x11; 32]), 0);
+            let destination = ScriptBuf::from_bytes(
+                hex::decode("512079be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798")
+                    .unwrap(),
+            );
+            let prevout = bitcoin::TxOut {
+                value: bitcoin::Amount::from_sat(response["rgb"]["htlcSat"].as_u64().unwrap()),
+                script_pubkey: script.clone(),
+            };
+            let leaf_len = hex::decode(
+                response["swapTree"]["claimLeaf"]["output"]
+                    .as_str()
+                    .unwrap(),
+            )
+            .unwrap()
+            .len();
+            let psbt =
+                maker_layer_rgb::build_taker_claim_psbt(&maker_layer_rgb::TakerClaimParams {
+                    htlc_outpoint: outpoint,
+                    htlc_txout: prevout,
+                    htlc_witness_weight: maker_layer_rgb::claim_leaf_witness_weight(
+                        leaf_len as u64,
+                    ),
+                    fee_rate_sat_vb: 5,
+                    dest_script: destination.clone(),
+                })
+                .unwrap();
+            claim = json!({"outpoint":outpoint.to_string(), "destinationScript":destination.to_hex_string(), "psbt":psbt.to_string()});
+        }
+        create[name] = json!({"request": request, "response":response});
+    }
+    let provenance = json!({"makerRevision":"49c6ce2e9554eea0d819fd3bbd267af6db45b1c0", "rgbLibRevision":"96f039d975cf2a83712c3c0a90e703621d445425", "rgbInvoicingVersion":"0.11.1-rc.11", "capture":"maker-api axum router; isolated PostgreSQL; mock node, chain and wallet; real rgb-lib recipient encoder", "network":"regtest", "assetPrecision":6, "assetIssued":false});
+    let wire = json!({"schemaVersion":1, "provenance":provenance, "contractId":ASSET, "preimage":hex::encode(preimage), "amountSemantics":{"limits":"inputAssetBaseUnits", "rate":"outputAssetBaseUnitsPerInputAssetBaseUnit", "quotedFees":"outputAssetBaseUnits", "rgbAmount":"contractUnits", "htlcSat":"bitcoinSatoshis"}, "pairResponses":pairs, "create":create});
+    let golden = json!({"schemaVersion":1,"provenance":provenance,"recipients":recipients,"takerClaim":claim,"feeModel":{"claimVsize":195,"claimFeeRate":5,"reverseHtlcSat":1521,"claimPayoutSat":546,"makerClaimVsize":294,"makerLockVsize":312,"submarineMinerFeeSat":470,"reverseLockFeeSat":1560}});
+    std::fs::create_dir_all(&output).unwrap();
+    for (name, value) in [
+        ("wire-contract.json", wire),
+        ("rgb-golden-vectors.json", golden),
+    ] {
+        std::fs::write(
+            std::path::Path::new(&output).join(name),
+            format!("{}\n", serde_json::to_string_pretty(&value).unwrap()),
+        )
+        .unwrap();
+    }
+}
